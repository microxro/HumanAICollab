{
  "name": "studyhold-school-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "StudyHold \u2014 a complete school tracker. Static front end (no framework, no build) plus Netlify Functions for accounts, sync, parent portal, and study groups.",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "serve": "python3 -m http.server 8000",
    "test": "node tests/run.mjs",
    "test:node": "node tests/migration.mjs && node tests/assets.mjs && node tests/email.mjs",
    "test:browser": "node tests/boot.mjs",
    "test:security": "node --import ./tests/stub/register.mjs tests/security.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "test:api": "node --import ./tests/stub/register.mjs tests/api.mjs",
    "test:teacher": "node --import ./tests/stub/register.mjs tests/teacher.mjs",
    "test:abuse": "node tests/abuse.mjs",
    "test:controls": "node tests/controls.mjs",
    "test:inventory": "node tests/inventory.mjs",
    "test:concurrency": "node --import ./tests/stub/register.mjs tests/concurrency.mjs",
    "test:hardening": "node --import ./tests/stub/register.mjs tests/hardening.mjs",
    "test:guidance": "node tests/guidance.mjs",
    "test:quotes": "node tests/quotes.mjs",
    "test:mobile": "node tests/mobile.mjs",
    "test:urlguard": "node tests/urlguard.mjs",
    "test:authwall": "node --import ./tests/stub/register.mjs tests/authwall.mjs",
    "test:shop": "node tests/shop.mjs",
    "test:activities": "node --import ./tests/stub/register.mjs tests/activities.mjs",
    "test:portal": "node tests/portal.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "axe-core": "^4.13.0"
  }
}
